<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>{% block title %}{% endblock %} - TED</title>
  <meta name="description" content="Tracking equitable transportation access in US cities.">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>

<body class="bg-slate-50 text-gray-800">
  {% include "nav.njk" %}

  {% block content %}
  {% endblock %}

  <footer class="text-gray-600">
    <div class="px-10 py-8 mx-auto flex items-center sm:flex-row flex-col">
      <a class="flex title-font font-medium items-center text-gray-900 mb-4 md:mb-0" href="https://transitcenter.org/">
        <img class="h-6 mr-3 sm:h-9" src="/assets/img/tc-logo.png" alt="TransitCenter Logo">
      </a>
      <p class="text-sm text-gray-500 sm:ml-4 sm:pl-4 sm:border-l-2 sm:border-gray-200 sm:py-2 sm:mt-0 mt-4">© {{ build.year }}
        TransitCenter. TED2 was proudly built by <a class="text-blue-400 hover:text-blue-600"
          href="https://www.klumpentown.com/">Klumpentown
          Consulting</a>.
      </p>
      <span class="inline-flex sm:ml-auto sm:mt-0 mt-4 justify-center sm:justify-start">
        <a href="/changelog/" class="text-sm text-gray-500 hover:text-gray-900">
          Version {{ site.version }}
        </a>
      </span>
    </div>
  </footer>

  {% block scripts %}
  {% endblock %}
</body>

</html>
